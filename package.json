{
  "name": "texelscope-workspace",
  "private": true,
  "description": "Workspace for the Texelscope web packages",
  "license": "MIT OR Apache-2.0",
  "workspaces": ["packages/sdk", "packages/ui", "packages/vite-plugin", "packages/extension"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "npm run dev -w @texelscope/ui",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:wasm": "wasm-pack build crates/texelscope-wasm --target web --out-dir ../../packages/ui/wasm"
  }
}
